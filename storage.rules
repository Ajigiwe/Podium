rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Profile pictures
    match /profile-pictures/{fileName} {
      // Anyone can view profile pictures
      allow read: if isSignedIn();
      
      // Only user can upload their own profile picture (must be named {userId}.jpg)
      allow write: if isSignedIn() 
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024 // 5MB max
        && request.resource.contentType == 'image/jpeg'; // Enforce JPEG
    }
    
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
