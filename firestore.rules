rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if profile exists
    function profileExists() {
      return exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }
    
    // Helper function to get the current user's profile data
    function getUserProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    // Helper function to check if user is a verified student (Course Rep)
    function isVerifiedStudent() {
      return isSignedIn() && profileExists() && 
             getUserProfile().get('role', '') == 'student' && 
             getUserProfile().get('isVerified', false) == true;
    }

    function isLecturer() {
      return isSignedIn() && profileExists() && getUserProfile().get('role', '') == 'lecturer';
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'minatoflash82@gmail.com' ||
        (profileExists() && getUserProfile().get('role', '') == 'admin')
      );
    }
    
    // Check if user is a member of a group
    function isGroupMember(groupId) {
      return isSignedIn() && exists(/databases/$(database)/documents/group_memberships/$(request.auth.uid + "_" + groupId));
    }

    // Check if user is the owner of a group
    function isGroupOwner(groupId) {
      return isSignedIn() && exists(/databases/$(database)/documents/groups/$(groupId)) && 
             get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    }
    
    // Profiles collection
    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
    }
    
    // Sessions collection
    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.get('hostId', '') == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.get('hostId', '') == request.auth.uid ||
        resource.data.get('lecturerId', '') == request.auth.uid ||
        isAdmin() ||
        (
          request.resource.data.status == 'paused' &&
          request.resource.data.auto_alert_triggered == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'auto_alert_triggered', 'auto_alert_triggered_at'])
        )
      );
      allow delete: if isSignedIn() && (
        resource.data.get('hostId', '') == request.auth.uid ||
        resource.data.get('lecturerId', '') == request.auth.uid ||
        isAdmin()
      );

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn(); // Simplified for now, keep subcollection specific rules if needed
      }
    }
    
    // Groups collection
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isLecturer() || isAdmin() || isVerifiedStudent();
      allow update, delete: if isAdmin() || isGroupOwner(groupId);

      // Announcements subcollection
      match /announcements/{annId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupOwner(groupId);
        allow delete: if isGroupOwner(groupId);
      }

      // Resources subcollection
      match /resources/{resId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupOwner(groupId);
        allow delete: if isGroupOwner(groupId);
      }
    }

    // Group memberships collection
    match /group_memberships/{membershipId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || 
                             resource.data.userId == request.auth.uid || 
                             isGroupOwner(resource.data.groupId);
    }

    // Group requests collection
    match /group_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isGroupOwner(resource.data.groupId) ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || isGroupOwner(resource.data.groupId);
      allow delete: if isAdmin() || resource.data.userId == request.auth.uid || isGroupOwner(resource.data.groupId);
    }

    // Verification Requests collection
    match /verification_requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == requestId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // System Settings & Attendance Logs (Standard)
    match /system_settings/{docId} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /attendance_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isLecturer() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.amount == 0;
    }
  }
}
