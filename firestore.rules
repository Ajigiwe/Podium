rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if profile exists
    function profileExists() {
      return exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }
    
    // Helper function to get the current user's profile data
    function getUserProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    // Helper function to get session data
    function getSessionData(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
    }

    // Helper function to check if user is the HOST of a session
    function isHost(sessionId) {
      return isSignedIn() && exists(/databases/$(database)/documents/sessions/$(sessionId)) && (
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('hostId', '') == request.auth.uid ||
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('lecturerId', '') == request.auth.uid
      );
    }
    
    // Helper function to check if user is a MODERATOR of a session
    function isMod(sessionId) {
      return isSignedIn() && exists(/databases/$(database)/documents/sessions/$(sessionId)) && (
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostId == request.auth.uid ||
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.lecturerId == request.auth.uid ||
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.backupModId == request.auth.uid ||
        // Co-hosts stored in subcollection
        (exists(/databases/$(database)/documents/sessions/$(sessionId)/co_hosts/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/sessions/$(sessionId)/co_hosts/$(request.auth.uid)).data.isActive == true)
      );
    }

    // LEGACY HELPERS (Keep for global checks if needed, but phase out)
    function isLecturer() {
      return isSignedIn() && profileExists() && getUserProfile().get('role', '') == 'lecturer';
    }
    function isStudent() {
      return isSignedIn() && profileExists() && getUserProfile().get('role', '') == 'student';
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'minatoflash82@gmail.com' ||
        (profileExists() && getUserProfile().get('role', '') == 'admin')
      );
    }
    
    // Profiles collection
    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow delete: if false;
    }
    
    // Sessions collection
    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.get('hostId', '') == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.get('hostId', '') == request.auth.uid ||
        resource.data.get('lecturerId', '') == request.auth.uid ||
        isAdmin() ||
        // Allow participants to trigger auto-alert lockdown if moderator is missing
        (
          request.resource.data.status == 'paused' &&
          request.resource.data.auto_alert_triggered == true &&
          // Ensure only status and alert fields are changing
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'auto_alert_triggered', 'auto_alert_triggered_at'])
        )
      );
      allow delete: if isSignedIn() && (
        resource.data.get('hostId', '') == request.auth.uid ||
        resource.data.get('lecturerId', '') == request.auth.uid ||
        isAdmin()
      );

      // Participants subcollection (Presence/Heartbeats)
      match /participants/{participantId} {
        allow read: if isSignedIn();
        // A user can write their own participant doc.
        // If a moderator is trying to write someone else's doc, they must be validated.
        // We split the rule so the simple check doesn't fail due to an exists() error on the parent doc
        allow write: if isSignedIn() && (
          request.auth.uid == participantId ||
          (exists(/databases/$(database)/documents/sessions/$(sessionId)) && (
            get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('hostId', '') == request.auth.uid ||
            get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('lecturerId', '') == request.auth.uid ||
            get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('backupModId', '') == request.auth.uid
          ))
        );
      }

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if false;
      }

      // Attendance subcollection
      match /attendance/{studentId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (
          request.auth.uid == studentId ||
          isMod(sessionId)
        );
      }

      // Verifications subcollection
      match /verifications/{verifId} {
        allow read: if isSignedIn();
        allow write: if isMod(sessionId);

        match /responses/{studentId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && request.auth.uid == studentId;
        }
      }

      // Permissions subcollection
      match /permissions/{participantId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (
          request.auth.uid == participantId ||
          isMod(sessionId)
        );
      }

      // Permission Requests subcollection
      match /permission_requests/{requestId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && (
          request.auth.uid == requestId ||
          isMod(sessionId)
        );
      }

      // Co-Hosts subcollection
      match /co_hosts/{coHostUserId} {
        allow read: if isSignedIn();
        // Only the session host may write co-host documents
        allow write: if isHost(sessionId);
      }

      // Chat History subcollection
      match /chat_history/{docId} {
        allow read: if isSignedIn();
        allow write: if isMod(sessionId);
      }

      // DIAGNOSTIC: Broad read for all subcollections
      match /{allSubcollections=**} {
        allow read: if isSignedIn();
      }
    }
    
    // Transactions collection
    match /transactions/{transactionId} {
      // Users can read their own transactions
      // Lecturers can read all transactions (for revenue tracking)
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isLecturer() || 
        isMod(resource.data.sessionId)
      );
      
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid 
        && request.resource.data.amount == 0
        && request.resource.data.status == 'succeeded';

      // Users can update their own transaction ONLY to hide it
      allow update: if isSignedIn() 
        && resource.data.userId == request.auth.uid
        // Ensure critical fields are not changed
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.status == resource.data.status
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.paystackReference == resource.data.paystackReference;

      // Only server can delete
      allow delete: if false;
    }
    
    // Attendance logs collection
    match /attendance_logs/{logId} {
      // Anyone authenticated can read attendance logs
      // Admins can manage everything in logs
      allow read: if isSignedIn();
      allow write: if isAdmin();
      
      // Users can create their own attendance logs
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      // Only moderators can update; Moderators OR Owners can delete
      allow update: if isMod(resource.data.sessionId);
      allow delete: if isMod(resource.data.sessionId) || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    // Settings collection
    match /system_settings/{docId} {
      allow read: if isSignedIn();
      // Only admins can update system settings
      allow write: if isAdmin();
    }
  }
}
