rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if profile exists
    function profileExists() {
      return exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }
    
    // Helper function to get the current user's profile data
    function getUserProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    // Helper function to check if user is a verified student (Course Rep)
    function isVerifiedStudent() {
      return isSignedIn() && profileExists() && 
             getUserProfile().get('role', '') == 'student' && 
             getUserProfile().get('isVerified', false) == true;
    }

    function isLecturer() {
      return isSignedIn() && profileExists() && getUserProfile().get('role', '') == 'lecturer';
    }

    function isAdmin() {
      return isSignedIn() && profileExists() && getUserProfile().get('role', '') == 'admin';
    }
    
    // Check if user is a member of a group
    function isGroupMember(groupId) {
      return isSignedIn() && exists(/databases/$(database)/documents/group_memberships/$(request.auth.uid + "_" + groupId));
    }

    // Check if user is the owner of a group
    function isGroupOwner(groupId) {
      return isSignedIn() && exists(/databases/$(database)/documents/groups/$(groupId)) && 
             get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    }

    // Check if user is a session co-host
    function isSessionCoHost(sessionId) {
      return isSignedIn() && exists(/databases/$(database)/documents/sessions/$(sessionId)/co_hosts/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/sessions/$(sessionId)/co_hosts/$(request.auth.uid)).data.isActive == true;
    }

    // Check if user is the session lecturer or host (reads the session doc)
    function isSessionLecturerOrHost(sessionId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('hostId', '') == request.auth.uid ||
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('lecturerId', '') == request.auth.uid
      );
    }

    // Check if user has joined this session (attendance log marker or presence heartbeat)
    function isSessionParticipant(sessionId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/sessions/$(sessionId)/participants/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/attendance_logs/$(sessionId + '_' + request.auth.uid))
      );
    }

    // Check if user is a session moderator (lecturer, host, co-host, or admin)
    function isSessionModerator(sessionId) {
      return isSignedIn() && (
        isAdmin() ||
        isSessionLecturerOrHost(sessionId) ||
        isSessionCoHost(sessionId)
      );
    }
    
    // Profiles collection — walletBalance only via Admin SDK
    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['walletBalance', 'walletUpdatedAt', 'walletCurrency', 'lecturerVerifiedAt', 'lecturerVerifiedBy'])
      );
    }
    
    // Sessions collection
    match /sessions/{sessionId} {
      allow read: if isSignedIn() && (
        resource.data.get('groupId', null) == null ||
        isGroupMember(resource.data.groupId) ||
        resource.data.get('lecturerId', '') == request.auth.uid ||
        isAdmin() ||
        isSessionParticipant(sessionId)
      );
      allow create: if isSignedIn() && request.resource.data.get('hostId', '') == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.get('hostId', '') == request.auth.uid ||
        resource.data.get('lecturerId', '') == request.auth.uid ||
        isAdmin() ||
        isSessionCoHost(sessionId) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount']) &&
          request.resource.data.participantCount == (resource.data.get('participantCount', 0) + 1)
        ) ||
        (
          request.resource.data.status == 'paused' &&
          request.resource.data.auto_alert_triggered == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'auto_alert_triggered', 'auto_alert_triggered_at'])
        )
      );
      allow delete: if isSignedIn() && (
        resource.data.get('hostId', '') == request.auth.uid ||
        resource.data.get('lecturerId', '') == request.auth.uid ||
        isAdmin()
      );

      // Co-hosts subcollection
      match /co_hosts/{coHostId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (
          isAdmin() ||
          resource.data.get('hostId', '') == request.auth.uid ||
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('hostId', '') == request.auth.uid
        );
      }

      // Permissions subcollection
      match /permissions/{participantId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (
          isSessionModerator(sessionId) ||
          (request.auth.uid == participantId && request.resource.data.keys().hasOnly(['microphone', 'camera']))
        );
      }

      // Permission requests subcollection
      match /permission_requests/{requestId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.participantId == request.auth.uid;
        allow update, delete: if isSignedIn() && isSessionModerator(sessionId);
      }

      // Attendance subcollection
      match /attendance/{studentId} {
        allow read: if isSignedIn() && (
          request.auth.uid == studentId || isSessionModerator(sessionId)
        );
        allow write: if isSignedIn() && isSessionModerator(sessionId);
      }

      // Presence heartbeats subcollection
      match /participants/{participantId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && request.auth.uid == participantId;
      }

      // Materials subcollection
      match /materials/{materialId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isSessionModerator(sessionId);
        allow delete: if isSignedIn() && isSessionModerator(sessionId);
      }

      // Verifications subcollection
      match /verifications/{eventId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && isSessionModerator(sessionId);
      }

      // Chat messages subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          isSessionLecturerOrHost(sessionId) ||
          isSessionCoHost(sessionId) ||
          isAdmin() ||
          isSessionParticipant(sessionId)
        );
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid && (
          isSessionLecturerOrHost(sessionId) ||
          isSessionCoHost(sessionId) ||
          isAdmin() ||
          isSessionParticipant(sessionId)
        );
      }

      // Chat history (transcript) subcollection
      match /chat_history/{docId} {
        allow read: if isSignedIn() && (
          isSessionLecturerOrHost(sessionId) ||
          isSessionCoHost(sessionId) ||
          isAdmin() ||
          isSessionParticipant(sessionId)
        );
        allow write: if isSignedIn() && (
          isSessionLecturerOrHost(sessionId) ||
          isAdmin()
        );
      }
    }
    
    // Groups collection
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isLecturer() || isAdmin() || isVerifiedStudent();
      allow update, delete: if isAdmin() || isGroupOwner(groupId);

      match /announcements/{annId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupOwner(groupId);
        allow delete: if isGroupOwner(groupId);
      }

      match /resources/{resId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupOwner(groupId);
        allow delete: if isGroupOwner(groupId);
      }
    }

    // Group memberships collection
    match /group_memberships/{membershipId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || 
                             resource.data.userId == request.auth.uid || 
                             isGroupOwner(resource.data.groupId) ||
                             resource.data.get('grantedBy', '') == request.auth.uid;
    }

    // Group requests collection
    match /group_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isGroupOwner(resource.data.groupId) ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || isGroupOwner(resource.data.groupId);
      allow delete: if isAdmin() || resource.data.userId == request.auth.uid || isGroupOwner(resource.data.groupId);
    }

    // Verification Requests collection
    match /verification_requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == requestId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // System Settings & Attendance Logs
    match /system_settings/{docId} { 
      allow read: if isSignedIn(); 
      allow write: if isAdmin(); 
    }
    
    match /attendance_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.lecturerId == request.auth.uid ||
        isSessionCoHost(resource.data.sessionId) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isLecturer() || isAdmin());
      // Client may only create free hide/show (amount 0); paid wallet/top_up/refund must go via Admin SDK
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.amount == 0 && request.resource.data.get('paymentChannel','') == 'direct';
      allow update, delete: if false; // only Admin SDK via APIs
    }

    // Wallet history is same as transactions read; no separate collection needed
  }
}
