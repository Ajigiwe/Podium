rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if profile exists
    function profileExists() {
      return exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }
    
    // Helper function to get user profile (only call after checking profileExists)
    function getUserProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }
    
    // Helper function to check if user is lecturer (safe version)
    function isLecturer() {
      return isSignedIn() && profileExists() && getUserProfile().get('role', '') == 'lecturer';
    }
    
    // Helper function to check if user is student (safe version)
    function isStudent() {
      return isSignedIn() && profileExists() && getUserProfile().get('role', '') == 'student';
    }

    // Helper function to check if user is admin (safe version)
    // Priorities email check to avoid rule errors if profile is partially missing
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'minatoflash82@gmail.com' ||
        (profileExists() && getUserProfile().get('role', '') == 'admin')
      );
    }
    
    // Profiles collection
    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow delete: if false;
    }
    
    // Sessions collection
    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isLecturer() && request.resource.data.lecturerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.lecturerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.lecturerId == request.auth.uid;

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if false;
      }

      // Attendance subcollection
      match /attendance/{studentId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (
          request.auth.uid == studentId ||
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.lecturerId == request.auth.uid
        );
      }

      // Verifications subcollection
      match /verifications/{verifId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && 
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.lecturerId == request.auth.uid;

        match /responses/{studentId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && request.auth.uid == studentId;
        }
      }

      // Permissions subcollection
      match /permissions/{participantId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (
          request.auth.uid == participantId ||
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.lecturerId == request.auth.uid
        );
      }

      // Permission Requests subcollection
      match /permission_requests/{requestId} {
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn() && (
          request.auth.uid == requestId ||
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.lecturerId == request.auth.uid
        );
      }

      // Chat History subcollection
      match /chat_history/{docId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && 
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.lecturerId == request.auth.uid;
      }

      // DIAGNOSTIC: Broad read for all subcollections
      match /{allSubcollections=**} {
        allow read: if isSignedIn();
      }
    }
    
    // Transactions collection
    match /transactions/{transactionId} {
      // Users can read their own transactions
      // Lecturers can read all transactions (for revenue tracking)
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isLecturer()
      );
      
      // Students can create 0-amount transactions for free class enrollments
      allow create: if isSignedIn() 
        && profileExists()
        && getUserProfile().role == 'student'
        && request.resource.data.userId == request.auth.uid 
        && request.resource.data.amount == 0
        && request.resource.data.status == 'succeeded';

      // Users can update their own transaction ONLY to hide it
      allow update: if isSignedIn() 
        && resource.data.userId == request.auth.uid
        // Ensure critical fields are not changed
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.status == resource.data.status
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.paystackReference == resource.data.paystackReference;

      // Only server can delete
      allow delete: if false;
    }
    
    // Attendance logs collection
    match /attendance_logs/{logId} {
      // Anyone authenticated can read attendance logs
      // Admins can manage everything in logs
      allow read: if isSignedIn();
      allow write: if isAdmin();
      
      // Users can create their own attendance logs
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      // Only lecturers can update; Lecturers OR Owners can delete
      allow update: if isLecturer();
      allow delete: if isLecturer() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    // Settings collection
    match /system_settings/{docId} {
      allow read: if isSignedIn();
      // Only admins can update system settings
      allow write: if isAdmin();
    }
  }
}
