{
    "rules": {
        "chats": {
            "$sessionId": {
                ".read": "auth != null",
                ".write": "auth != null",
                "$messageId": {
                    ".validate": "newData.hasChildren(['userId', 'userName', 'userRole', 'content', 'createdAt'])"
                }
            }
        },
        "reactions": {
            "$sessionId": {
                ".read": "auth != null",
                ".write": "auth != null"
            }
        }
    }
}